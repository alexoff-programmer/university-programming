# Пользовательские файлы Visual Studio (настройки окон, закладки, локальные опции)
*.suo
*.user
*.userosscpp
*.userosv
*.sln.docstates

# Скомпилированные файлы и выходные данные
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
ARM/
arm64/
out/
build/
[Bb]in/
[Oo]bj/

# Исполняемые файлы и динамические библиотеки
*.exe
*.dll
*.so
*.dylib

# Отладочные, объектные и вспомогательные файлы сборщика
*.obj
*.o
*.ilk
*.metagen
*.pdb
*.idb
*.tlog
*.trx
*.aps
*.bsc
*.ncb
*.res
*.sbr
*.exp
*.lib

# Кэш IntelliSense, предкомпилированные заголовки и базы данных кода
.vs/
*.ipch
*.pch
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# Локальные пользовательские файлы проектов
*.rc.user
*.vcxproj.user

# Резервные копии и временные файлы
*~
*.bak
*.tmp
*.log
*.err
*.old

#-------------------------------------------------------------------------------
# NuGet / Пакеты
#-------------------------------------------------------------------------------

packages/
*.nuget.props
*.nuget.targets

#-------------------------------------------------------------------------------
# CMake (если используется)
#-------------------------------------------------------------------------------

CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/
Testing/
_CPack_Packages/
DartConfiguration.tcl
CTestTestfile.cmake
cmake_install.cmake
install/

